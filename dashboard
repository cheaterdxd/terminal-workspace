#!/usr/bin/env bash
# ==============================================================================
# Launcher mở Cyber Threat Intel & Personal Workspace Dashboard
# ==============================================================================
set -e

UV_BIN="$HOME/.local/bin/uv"

if command -v uv >/dev/null 2>&1; then
    UV_CMD="uv"
elif [ -f "$UV_BIN" ]; then
    UV_CMD="$UV_BIN"
else
    echo "Lỗi: Không tìm thấy công cụ uv."
    exit 1
fi

exec "$UV_CMD" run --with textual python3 "/home/letuan/make_Kubuntu_better/cyber_dashboard.py" "$@"

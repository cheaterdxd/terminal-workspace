#!/usr/bin/env python3
"""
Buddy - Terminal Companion & Mascot CLI for Kubuntu
Linh vật Kaomoji đồng hành tương tác ngay trên Terminal.
"""

import sys
import os
import time
import argparse
import random

# Import Mascot Engine
SCRIPT_DIR = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, SCRIPT_DIR)
import mascot_engine

TASKS_FILE = os.path.expanduser("~/.workspace_tasks.json")
PLAN_FILE = os.path.expanduser("~/.workspace_tomorrow_plan.json")

def get_tomorrow_plan() -> list[dict]:
    """Đọc danh sách kế hoạch ngày mai."""
    if not os.path.exists(PLAN_FILE):
        return []
    try:
        import json
        with open(PLAN_FILE, "r", encoding="utf-8") as f:
            plan = json.load(f)
            return plan if isinstance(plan, list) else []
    except Exception:
        return []

# ANSI Color Codes
CYAN = "\033[1;36m"
GREEN = "\033[1;32m"
YELLOW = "\033[1;33m"
MAGENTA = "\033[1;35m"
BLUE = "\033[1;34m"
WHITE = "\033[1;37m"
DIM = "\033[2m"
RESET = "\033[0m"
BOLD = "\033[1m"

def get_tasks_summary() -> tuple[int, int, int]:
    """Trả về (total, done, in_progress) từ workspace tasks."""
    if not os.path.exists(TASKS_FILE):
        return 0, 0, 0
    try:
        import json
        with open(TASKS_FILE, "r", encoding="utf-8") as f:
            tasks = json.load(f)
            if isinstance(tasks, list):
                total = len(tasks)
                done = sum(1 for t in tasks if t.get("status") == "done")
                in_prog = sum(1 for t in tasks if t.get("status") == "in_progress")
                return total, done, in_prog
    except Exception:
        pass
    return 0, 0, 0

def print_speech_bubble(face: str, message: str, subtitle: str = None, name: str = "Kubi"):
    """In khung thoại Kaomoji rực rỡ trên terminal."""
    max_w = min(len(message) + 4, 64)
    max_w = max(max_w, 36)
    
    top = f"{CYAN}╭" + "─" * (max_w - 2) + f"╮{RESET}"
    bot = f"{CYAN}╰" + "─" * (max_w - 2) + f"╯{RESET}"
    
    print(top)
    print(f"{CYAN}│{RESET} {WHITE}{message:<{max_w-4}}{RESET} {CYAN}│{RESET}")
    if subtitle:
        print(f"{CYAN}│{RESET} {DIM}{subtitle:<{max_w-4}}{RESET} {CYAN}│{RESET}")
    print(bot)
    print(f"        {CYAN}╰─{RESET} {MAGENTA}{face}{RESET} {BOLD}{CYAN}{name}{RESET}\n")

def cmd_hello(style: str = None):
    """Hiển thị sân khấu Pixel Mascot sống động kèm tiến độ công việc."""
    import shutil
    try:
        from rich.console import Console
        console = Console()
    except ImportError:
        console = None

    cols = shutil.get_terminal_size((60, 20)).columns
    stage_w = min(cols - 2, 70)
    habitat = mascot_engine.MascotHabitat(stage_width=stage_w, style=style)
    
    total, done, in_prog = get_tasks_summary()
    if total > 0:
        habitat.current_msg = f"Tiến độ hôm nay: {done}/{total} việc hoàn tất! Tiếp tục giữ vững phong độ nhé!"

    rendered = habitat.render(stage_w)
    if console:
        console.print(rendered)
    else:
        print(rendered)

    plan_items = get_tomorrow_plan()
    plan_str = f" {CYAN}│ Ngày mai: {len(plan_items)} việc dự kiến{RESET}" if plan_items else ""
    if total > 0:
        print(f"  {CYAN}📋 Công việc hôm nay:{RESET} {GREEN}{done}/{total} đã xong{RESET} {DIM}({in_prog} đang làm){RESET}{plan_str}\n")
    else:
        if plan_items:
            print(f"  {CYAN}✨ Bạn đã có {len(plan_items)} việc dự kiến cho ngày mai! (Gõ 'buddy plan' để xem){RESET}\n")
        else:
            print(f"  {CYAN}✨ Sẵn sàng làm việc cùng bạn trên Kubuntu Terminal!{RESET}\n")

def cmd_plan():
    """Xem danh sách kế hoạch ngày mai cùng Kubi."""
    plan_items = get_tomorrow_plan()
    if not plan_items:
        face = mascot_engine.get_random_face("idle")
        print_speech_bubble(face, "Chưa có kế hoạch nào cho ngày mai!", subtitle="💡 Gõ 'dashboard' hoặc lệnh 'plan: ...' để lên lịch nhé!")
        return

    face = mascot_engine.get_random_face("celebrate")
    print_speech_bubble(face, f"Bạn đã chuẩn bị sẵn {len(plan_items)} việc cho ngày mai!", subtitle="📅 Kế hoạch làm việc ngày mai (Tomorrow's Plan)")
    print(f"  {BOLD}{CYAN}Danh sách công việc dự kiến:{RESET}")
    for item in plan_items:
        p_id = item.get("id", 0)
        p_tag = item.get("tag", "PLAN")
        p_title = item.get("title", "")
        print(f"    {DIM}#{p_id:02d}{RESET}  {BLUE}[{p_tag}]{RESET} {WHITE}{p_title}{RESET}")
    print(f"\n  {DIM}💡 Mẹo: Mở dashboard bấm phím [m] hoặc [b] để nạp vào ngày mới.{RESET}\n")

def cmd_log():
    """Xem nhật ký làm việc gần nhất từ ~/work_logs/."""
    log_dir = os.path.expanduser("~/work_logs")
    if not os.path.exists(log_dir):
        face = mascot_engine.get_random_face("idle")
        print_speech_bubble(face, "Chưa có nhật ký nào được lưu!", subtitle="💡 Bấm 'w' trong dashboard để xuất nhật ký ngày nhé!")
        return

    files = sorted([f for f in os.listdir(log_dir) if f.startswith("daily_") and f.endswith(".md")], reverse=True)
    if not files:
        face = mascot_engine.get_random_face("idle")
        print_speech_bubble(face, "Thư mục ~/work_logs chưa có file nhật ký!", subtitle="💡 Bấm 'w' trong dashboard để xuất nhật ký ngày nhé!")
        return

    latest = files[0]
    filepath = os.path.join(log_dir, latest)
    try:
        with open(filepath, "r", encoding="utf-8") as f:
            content = f.read()
        face = mascot_engine.get_random_face("celebrate")
        print_speech_bubble(face, f"Nhật ký làm việc ngày: {latest[6:-3]}", subtitle=f"📁 {filepath} ({len(files)} ngày đã lưu)")
        for line in content.splitlines():
            if line.startswith("# "):
                print(f"{BOLD}{CYAN}{line}{RESET}")
            elif line.startswith("## "):
                print(f"\n{BOLD}{YELLOW}{line}{RESET}")
            elif line.startswith("### "):
                print(f"{BOLD}{GREEN}{line}{RESET}")
            elif line.startswith("- [x]"):
                print(f"  {GREEN}✓{RESET} {line[5:].strip()}")
            elif line.startswith("- [ ]"):
                print(f"  {YELLOW}•{RESET} {line[5:].strip()}")
            elif line.startswith(">"):
                print(f"  {DIM}{line}{RESET}")
            else:
                print(f"  {line}")
        print()
    except Exception as e:
        print(f"{YELLOW}Lỗi đọc file: {e}{RESET}")

def cmd_library():
    """Xem danh sách và thống kê các bài phân tích AI trong thư viện."""
    lib_dir = os.path.expanduser("~/work_logs/library")
    index_file = os.path.join(lib_dir, "library_index.json")
    items = []
    if os.path.exists(index_file):
        try:
            import json
            with open(index_file, "r", encoding="utf-8") as f:
                items = json.load(f)
        except Exception:
            pass

    if not items:
        face = mascot_engine.get_random_face("idle")
        print_speech_bubble(face, "Thư viện AI hiện chưa có bài phân tích nào!", subtitle="💡 Trong dashboard, bấm phím [v] hoặc [x] để tự động lưu bài nhé!")
        return

    face = mascot_engine.get_random_face("celebrate")
    print_speech_bubble(face, f"Thư viện tri thức an ninh mạng đang có {len(items)} bài phân tích!", subtitle="📚 AI Threat Intel Knowledge Base")
    print(f"  {BOLD}{CYAN}5 bài phân tích gần nhất:{RESET}")
    for item in items[:5]:
        vendor = item.get("vendor", "Intel")
        badge = item.get("mode_badge", "BÁO CÁO")
        title = item.get("title", "")
        date = item.get("created_at", "")[:10]
        cves = item.get("cves", [])
        cve_str = f" {YELLOW}({', '.join(cves[:2])}){RESET}" if cves else ""
        print(f"    {DIM}[{date}]{RESET} {MAGENTA}[{badge}]{RESET} {CYAN}[{vendor}]{RESET} {WHITE}{title[:55]}{RESET}{cve_str}")
    
    print(f"\n  {DIM}💡 Mẹo: Mở dashboard bấm phím [l] để duyệt đọc toàn văn, hoặc mở ~/work_logs/library/{RESET}\n")

def cmd_style(style_name: str):
    """Đổi phong cách linh vật pixel."""
    style_name = (style_name or "").lower().strip()
    if style_name in ("cat", "robo", "slime", "dino", "kaomoji"):
        mascot_engine.save_mascot_config({"style": style_name})
        print(f"\n{GREEN}✔ Đã đổi phong cách linh vật sang: {BOLD}{style_name.upper()}{RESET}\n")
        cmd_hello(style=style_name)
    else:
        print(f"\n{YELLOW}Phong cách không hợp lệ! Vui lòng chọn một trong các kiểu pixel:{RESET}")
        print(f"  • {BOLD}cat{RESET}: Mèo máy Cyber Neko pixel (Mặc định)")
        print(f"  • {BOLD}robo{RESET}: Robot 8-bit Cyber Bot tương lai")
        print(f"  • {BOLD}slime{RESET}: Bé Slime RPG retro núng nính")
        print(f"  • {BOLD}dino{RESET}: Khủng long pixel mini tinh nghịch")
        print(f"  • {BOLD}kaomoji{RESET}: Mặt chữ cổ điển ( ˶•ᴗ•˶ )\n")


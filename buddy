    face = mascot_engine.get_random_face(mood)
    print_speech_bubble(face, message)

def cmd_focus(minutes: int = 25):
    """Đếm giờ Focus cùng linh vật ngay trong terminal."""
    total_sec = minutes * 60
    rem = total_sec
    
    print(f"\n{BOLD}{CYAN}⏱ BẮT ĐẦU PHIÊN FOCUS {minutes} PHÚT CÙNG KUBI{RESET}")
    print(f"{DIM}Nhấn Ctrl+C để kết thúc sớm.{RESET}\n")
    
    try:
        while rem > 0:
            m = rem // 60
            s = rem % 60
            pct = int((total_sec - rem) / total_sec * 100)
            bar_len = 20
            filled = int(bar_len * pct / 100)
            bar = f"{GREEN}{'━' * filled}{DIM}{'─' * (bar_len - filled)}{RESET}"
            
            # Đổi biểu cảm theo nhịp
            face = "🎧( •̀_•́ )" if rem % 4 >= 2 else "💻( •̀ω•́ )"
            
            sys.stdout.write(f"\r  {MAGENTA}{face}{RESET}  {bar} {BOLD}{CYAN}{m:02d}:{s:02d}{RESET} ({pct}%)  ")
            sys.stdout.flush()
            time.sleep(1)
            rem -= 1
            
        print(f"\n\n{GREEN}🎉 HOÀN THÀNH PHIÊN FOCUS {minutes} PHÚT!{RESET}")
        cmd_say(mascot_engine.get_dialogue("focus_done"), mood="celebrate")
    except KeyboardInterrupt:
        print(f"\n\n{YELLOW}Đã dừng phiên Focus sớm.{RESET}")

def cmd_watch(style: str = None):
    """Mini Desk Pet chạy trực tiếp trên terminal với sân khấu đi lại tự nhiên."""
    import shutil
    try:
        from rich.console import Console
        console = Console()
    except ImportError:
        console = None

    cols = shutil.get_terminal_size((60, 20)).columns
    stage_w = min(cols - 2, 70)
    habitat = mascot_engine.MascotHabitat(stage_width=stage_w, style=style)

    print(f"\n{CYAN}🐾 Kubi đang đi dạo trên bàn làm việc cùng bạn...{RESET} {DIM}(Ctrl+C để dừng){RESET}\n")
    print("\n" * 9)
    
    try:
        while True:
            cols = shutil.get_terminal_size((60, 20)).columns
            stage_w = min(cols - 2, 70)
            habitat.tick(stage_w)
            rendered = habitat.render(stage_w)
            
            sys.stdout.write("\033[10A\r")
            if console:
                console.print(rendered)
            else:
                for line in rendered.split("\n"):
                    sys.stdout.write(f"\033[2K{line}\n")
            sys.stdout.flush()
            time.sleep(1.2)
    except KeyboardInterrupt:
        print(f"\n\n  ( ＾◡＾)っ Tạm biệt bạn nhé! Chúc một ngày năng suất!\n")

def main():
    parser = argparse.ArgumentParser(
        description="🐾 Kubi - Pixel & Kaomoji Mascot & Companion for Kubuntu"
    )
    subparsers = parser.add_subparsers(dest="command", help="Lệnh linh vật")
    
    # Subcommands
    hello_parser = subparsers.add_parser("hello", help="Chào hỏi và xem sân khấu pixel")
    hello_parser.add_argument("--style", type=str, help="Kiểu pixel: cat, robo, slime, dino, kaomoji")

    style_parser = subparsers.add_parser("style", help="Đổi phong cách pixel: cat, robo, slime, dino, kaomoji")
    style_parser.add_argument("name", type=str, nargs="?", default="cat", help="Tên kiểu: cat, robo, slime, dino, kaomoji")

    subparsers.add_parser("cheer", help="Cổ vũ tinh thần khi fix bug")
    
    watch_parser = subparsers.add_parser("watch", help="Bật chế độ Mini Desk Pet đi dạo trên terminal")
    watch_parser.add_argument("--style", type=str, help="Kiểu pixel: cat, robo, slime, dino, kaomoji")
    
    focus_parser = subparsers.add_parser("focus", help="Đếm giờ Focus cùng Kubi")
    focus_parser.add_argument("minutes", type=int, nargs="?", default=25, help="Số phút tập trung (mặc định 25)")
    
    say_parser = subparsers.add_parser("say", help="Kubi nói câu bất kỳ")
    say_parser.add_argument("message", type=str, help="Nội dung muốn Kubi nói")
    say_parser.add_argument("--mood", type=str, default="happy", help="Tâm trạng (idle, focus, celebrate...)")
    subparsers.add_parser("plan", help="Xem kế hoạch làm việc cho ngày mai")
    subparsers.add_parser("log", help="Xem nhật ký làm việc gần nhất")
    subparsers.add_parser("logs", help="Xem nhật ký làm việc gần nhất")
    subparsers.add_parser("lib", help="Xem thư viện các bài phân tích AI")
    subparsers.add_parser("library", help="Xem thư viện các bài phân tích AI")
    
    args = parser.parse_args()
    
    if args.command == "style":
        cmd_style(args.name)
    elif args.command == "cheer":
        cmd_cheer()
    elif args.command == "watch":
        cmd_watch(style=args.style)
    elif args.command == "focus":
        cmd_focus(args.minutes)
    elif args.command == "say":
        cmd_say(args.message, args.mood)
    elif args.command == "plan":
        cmd_plan()
    elif args.command in ("log", "logs"):
        cmd_log()
    elif args.command in ("lib", "library"):
        cmd_library()
    else:
        style = getattr(args, "style", None)
        cmd_hello(style=style)

if __name__ == "__main__":
    main()
